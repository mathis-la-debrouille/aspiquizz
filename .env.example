DATABASE_URL=              # libsql://... ; if empty, falls back to file:./local.db
DATABASE_AUTH_TOKEN=       # Turso token
SESSION_COOKIE_NAME=aspi_session
UPLOAD_DIR=/data/uploads   # Railway persistent volume mount; defaults to ./.uploads locally
PORT=3000
NODE_ENV=development
MCP_ENABLED=true            # kill switch — set false to make /mcp 404 with no redeploy (Addendum C.2)
PUBLIC_BASE_URL=            # e.g. https://quiz.example.com ; used for the /mcp Origin check and the setup snippet
